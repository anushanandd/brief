{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Brief",
  "version": "0.1.0",
  "identifier": "com.brief.finance",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Brief",
        "width": 1280,
        "height": 820,
        "minWidth": 860,
        "minHeight": 620,
        "resizable": true,
        "maximized": true,
        "visible": false,
        "backgroundColor": "#000000",
        "theme": "Dark",
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "fullscreen": false
      }
    ],
    "security": {
      "dangerousDisableAssetCspModification": ["style-src"],
      "csp": "default-src 'self'; img-src 'self' asset: data: blob: https://img.logo.dev https://plaid-merchant-logos.plaid.com; style-src 'self' 'unsafe-inline'; font-src 'self' data:; frame-src blob:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "createUpdaterArtifacts": true,
    "icon": ["icons/icon.icns", "icons/128x128@2x.png"],
    "category": "Finance",
    "shortDescription": "A calm personal finance workspace",
    "macOS": {
      "entitlements": "Entitlements.plist",
      "minimumSystemVersion": "14.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZFNTRDOEY3MDhEREE3MjkKUldRcHA5MEk5OGhVYnJFTDhZYXhkbVU4SmNBQWZ4VU03RU56WStPSnVqQjhld2VhT3hUeW5uWisK",
      "endpoints": ["https://github.com/anushanandd/brief/releases/latest/download/latest.json"]
    }
  }
}
